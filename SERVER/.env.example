# ============================
# 🚀 SERVER CONFIGURATION
# ============================
PORT=5000
NODE_ENV=development

# ============================
# 🗄️ DATABASE (Optional - Currently using LokiJS)
# ============================
# Uncomment if using MongoDB
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kaira

# ============================
# 🔐 JWT AUTHENTICATION
# ============================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=kaira_secret_key_2024
JWT_EXPIRE=7d

# ============================
# ☁️ CLOUDINARY (Optional - for image uploads)
# ============================
# Get from https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================
# 💰 RAZORPAY PAYMENT GATEWAY
# ============================
# Get from https://razorpay.com
# TEST KEYS (No real money will be deducted)
RAZORPAY_KEY_ID=rzp_test_TISttRIM2woSMu
RAZORPAY_KEY_SECRET=TNOLrJ89rCiDsHwtDDkatuvX

# LIVE KEYS (Uncomment when going live)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ============================
# 📧 EMAIL CONFIGURATION (Optional)
# ============================
# Gmail App Password - Get from Google Account Settings
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# ============================
# 👤 ADMIN ACCOUNT
# ============================
ADMIN_EMAIL=admin@kaira.com
ADMIN_PASSWORD=Admin@123

# ============================
# 🌐 FRONTEND URLS (CORS)
# ============================
# Production
FRONTEND_URL=https://kairaliving.vercel.app

# Development (uncomment if needed)
# FRONTEND_URL=http://localhost:5500
# FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:5000

# Additional allowed origins (comma-separated)
# ADDITIONAL_ORIGINS=https://kaira-living.vercel.app,http://localhost:3000

# ============================
# 🛠️ DEBUGGING
# ============================
DEBUG=kaira:*
LOG_LEVEL=info

# ============================
# 🗃️ LOKIJS DATABASE
# ============================
# File path for LokiJS database
DB_PATH=./database.json
DB_AUTOSAVE_INTERVAL=4000

# ============================
# 🔧 OTHER SETTINGS
# ============================
# Rate limiting (requests per minute)
RATE_LIMIT=100

# Session timeout (minutes)
SESSION_TIMEOUT=60

# ============================
# 📦 DEPLOYMENT (RENDER.COM)
# ============================
# These are set automatically on Render
# PORT - Automatically set by Render
# NODE_ENV - Set to 'production' on Render